# Dendri Signaling Server — Environment Variables
# Copy this file to .env and adjust for your deployment.
# All values shown are defaults. Commented lines are optional.

# --- Network ---
PORT=9000
# HOST=::
# PATH=/                  # URL path prefix (PEERSERVER_PATH)

# --- Security ---
DENDRI_KEY=dendri                       # Change in production!
# DENDRI_KEY_FILE=/etc/dendri/key        # Overrides DENDRI_KEY, more secure
# DENDRI_JWT_SECRET=                     # Enables JWT auth if set
# DENDRI_ALLOW_DISCOVERY=false           # Set true to enable GET /:key/peers
# DENDRI_DISCOVERY_TOKEN=                # Required ?token= param for /peers
# DENDRI_STRIP_ICE_CANDIDATES=false      # Strip ICE candidates to prevent IP leaks

# --- Multi-tenant / hosted mode ---
# DENDRI_ADMIN_TOKEN=                    # Set to mount /admin + /me + /auth dashboard routes (Bearer auth; also signs dashboard session/magic JWTs)
# DENDRI_REQUIRE_API_KEY=false           # true = every connection must present a valid tenant api_key

# --- Dashboard magic-link email (Alibaba DirectMail) ---
# DENDRI_MAIL_AK_ID=                     # DirectMail-scoped RAM access key id (enables /auth/request magic-link)
# DENDRI_MAIL_AK_SECRET=                 # DirectMail-scoped RAM access key secret
# DENDRI_MAIL_REGION=ap-southeast-1      # DirectMail region (endpoint dm.<region>.aliyuncs.com)
# DENDRI_MAIL_FROM=noreply@dendri.dev    # Verified DirectMail sender address
# DENDRI_DASHBOARD_URL=https://app.dendri.dev  # Base URL used in magic-link emails
# When a client presents ?api_key=..., rooms/peers/presence/replay are namespaced
# per tenant, so two tenants' identically named rooms never intersect.

# --- Abuse limits ---
# DENDRI_MAX_ROOMS_PER_CLIENT=32         # cap rooms one client may join (0=unlimited)
# DENDRI_MAX_TOTAL_ROOMS=10000           # cap distinct rooms server-wide (0=unlimited)

# --- CORS (repeat --cors for multiple origins) ---
# DENDRI_CORS=https://example.com,https://app.example.com
# Note: CORS is provided via CLI flag (--cors), not env var.
# If empty, server rejects all cross-origin requests.

# --- TLS ---
# SSLKEY=/path/to/privkey.pem
# SSLCERT=/path/to/fullchain.pem

# --- Rate Limiting ---
# RATE_LIMIT_SIGNALING=10                # signaling msgs/sec/client
# RATE_LIMIT_DATA=100                    # data msgs/sec/client
# CONCURRENT_LIMIT=5000                  # max simultaneous clients

# --- Message Handling ---
# MAX_MESSAGE_SIZE=65536                 # max payload in bytes
# MAX_ROOM_SIZE=50                       # max clients per room (0=unlimited)
# ALIVE_TIMEOUT=60000                    # heartbeat timeout (ms)
# EXPIRE_TIMEOUT=5000                    # queued message expiry (ms)
# CLEANUP_OUT_MSGS=1000                  # cleanup interval (ms)

# --- TURN ---
# TURN_SECRET=                           # HMAC secret for short-lived creds
# TURN_SERVERS=stun:turn.example.com:3478,turn:turn.example.com:3478

# --- Relay ---
# DENDRI_ENABLE_RELAY=false              # WebSocket data relay (hybrid mode)

# --- Replay Buffer ---
# REPLAY_BUFFER_SIZE=1000                # max messages per client
# REPLAY_BUFFER_TTL=300000               # buffer TTL in ms (5 min)

# --- Session ---
# DENDRI_SESSION_TTL=30000               # grace period before room removal (ms)

# --- Webhook ---
# DENDRI_WEBHOOK_URL=                    # POST events here on connect/disconnect
# DENDRI_WEBHOOK_SECRET=                 # HMAC-SHA256 signing secret

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- Debug ---
# RUST_LOG=dendri=info                   # set to dendri=debug for verbose logging
# DENDRI_LOG_PII=false                   # set true to log plain room names
